# Base Kata assets are authoritative on the host, not in git: a committed copy
# goes stale silently (the initrd that used to live here was truncated and cpio
# reported no error). Fetch them with `build-initrd.sh fetch-base`; the paths and
# hashes of whatever was fetched are recorded in base/source-paths.txt.
base/*.img
base/*.container
base/*.fd
base/*.part

# Build output. It is derived state, and the copy once committed here was
# byte-identical to the base initrd rather than a real build product.
out/

# Semgrep payload (jammy Python 3.10 runtime + a 319 MiB site-packages tree, of
# which semgrep-core alone is 245 MiB) injected into the initrd when the config
# selects the semgrep engine. Rebuild it with build-semgrep-payload.sh; the size
# is exactly why it is not tracked.
semgrep-payload/

# The shipped Kata config is host-authoritative like the initrd above; fetch-base
# copies it and render rewrites it. A committed copy would go stale silently.
base/*.toml

# Rendered delivery packages (Kata config, containerd fragment, K8s manifests,
# manifest.env, SHA256SUMS). Derived state: rebuild with `render`.
dist/

# Python bytecode from the renderer (render/render.py).
__pycache__/
