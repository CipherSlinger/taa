# ============================================================================
#  TAA Pod (Kata CSV2 confidential VM) -- TEMPLATE
# ----------------------------------------------------------------------------
#  This is a TEMPLATE, not a file to apply by hand. deploy.sh renders it and
#  creates the Pod only when TARGET_POD was not set; when the operator names a
#  Pod, the deployment never creates one.
#
#  Placeholders, all substituted by deploy.sh:
#
#    POD_NAME         metadata.name          (TARGET_POD, default taa-deploy)
#    NAMESPACE        metadata.namespace     (TARGET_NAMESPACE, default osr)
#    IMAGE            containers[0].image    (TAA_POD_IMAGE; when unset, built and pushed)
#    PULL_POLICY      imagePullPolicy        (TAA_POD_PULL_POLICY; Always for an auto-built image)
#    NODE_NAME        spec.nodeName          (TAA_POD_NODE)
#    RUNTIME_CLASS    runtimeClassName       (TAA_POD_RUNTIME_CLASS)
#    CPU, MEMORY      container resources    (TAA_POD_CPU, TAA_POD_MEMORY)
#    CC_INIT_DATA     cc_init_data annotation, read from a running CoCo Pod or rendered from TAA_POD_INITDATA_FILE
#    CONTRACT_TYPE    env CONTRACT_TYPE      (TAA_POD_CONTRACT_TYPE; 1/2 tee, 3 data analysis)
#    DOCKER_ID        env DOCKER_ID          (TAA_POD_DOCKER_ID, default Pod name)
#    PLATFORM_IP      env PLATFORM_IP        (REMOTE_PLATFORM_IP)
#    PLATFORM_PUBLIC_KEY env PLATFORM_PUBLIC_KEY (TAA_POD_PLATFORM_PUBLIC_KEY, PLATFORM_PUBLIC_KEY, or read from the host)
#    CONTRACT_ID      env CONTRACT_ID        (CONTRACT_ID)
#
#  CONTRACT_TYPE is the role the instance runs. It is injected here rather than rendered into
#  taa-config.json so that one image can be deployed as either role, and because a Pod's
#  environment is immutable: changing the role means recreating the Pod.
#
#  The LLM endpoint is deliberately not an env var here: an env value outlives every deployment
#  and would override the endpoint written into taa-config.json on each run, so a later deploy
#  with a different LLM_IP would silently keep the old one. The config file is the sole source.
#
#  The placeholders in this comment carry no underscores; the fields below carry
#  them wrapped in double underscores, so the sed pass substitutes the fields
#  and leaves the documentation readable.
#
#  The container has no `command`: the image's ENTRYPOINT is
#  `bash /root/taa/taa-supervisor.sh`, the role's own autostart file (manual-file
#  gate, flock singleton, restart loop, log at /root/taa/taa.log). Every role
#  installs exactly one file under that name: the tee role's starts taa only, the
#  data-analysis role's also starts jupyter, and the FHE role's also starts
#  /opt/entrypoint.sh. That is what makes the deployment's `touch manual` /
#  `rm manual` protocol work on a freshly created Pod.
# ============================================================================
apiVersion: v1
kind: Pod
metadata:
  # A literal name, never generateName: a second Pod is a second confidential
  # VM, and CSV2 encrypted memory is resident from boot, so a stray duplicate
  # costs tens of GiB until someone notices it.
  name: __POD_NAME__
  namespace: __NAMESPACE__
  labels:
    app: taa
    # The instance's registered identity. Every Pod of this deployment carries it, and the
    # NodePort Service created beside the Pod selects on it, so recreating the Pod under the
    # same DOCKER_ID keeps the Service pointing at the new one without a second edit. A label
    # value may contain only alphanumerics, '-', '_' and '.', and must be at most 63
    # characters; deploy.sh validates the id before the manifest is applied.
    taa-instance-id: "__TAA_INSTANCE_ID__"
  annotations:
    # Required. The guest pulls the image through its own CDH, and the host's
    # trust in the local registry's self-signed certificate does not carry into
    # the guest. Without this annotation the Pod stops in StartError.
    io.katacontainers.config.runtime.cc_init_data: __CC_INIT_DATA__
    # Non-empty on purpose: a hypervisor parameter value is appended to the
    # config file's own parameters, so an empty value would erase the rdinit=
    # that boots the guest. These are the same timeouts the production TAA Pod
    # carries for an in-guest image pull.
    io.katacontainers.config.hypervisor.kernel_params: "agent.cdh_api_timeout=1200 agent.image_pull_timeout=3600"
    # io.containerd.cri.runtime-handler is deliberately not set: it hijacks the
    # runtime selection away from runtimeClassName (see teellm-pod.yaml.tmpl).
spec:
  # The RuntimeClass that boots a CSV2 guest, which is what makes the
  # /dev/csv-guest kernel driver available at all.
  runtimeClassName: __RUNTIME_CLASS__
  nodeName: __NODE_NAME__
  nodeSelector:
    katacontainers.io/kata-runtime: "true"
  restartPolicy: Always
  # Must outlast the preStop quiet period below (90s) with room for the guest to shut
  # down. A preStop has no timeout of its own; this grace period is what bounds it.
  terminationGracePeriodSeconds: 120
  containers:
    - name: taa
      image: __IMAGE__
      # The auto-built image carries today's date and is mutable, so the deployment sets
      # Always for it: the guest must fetch the manifest rather than accept a cached copy of an
      # image that was rebuilt under the same tag. A pinned TAA_POD_IMAGE keeps IfNotPresent.
      imagePullPolicy: __PULL_POLICY__
      env:
        # The instance role. 1 and 2 both select the ordinary tee role, 3 selects
        # data analysis; the deployment injects the value so the image stays
        # role-free and the config needs no rendering.
        - name: CONTRACT_TYPE
          value: "__CONTRACT_TYPE__"
        # The remote config path writes a template without a `platform` block,
        # so these are the only source of the registration identity; deploy.sh
        # refuses to finish when either is empty.
        - name: DOCKER_ID
          value: "__DOCKER_ID__"
        - name: PLATFORM_IP
          value: "__PLATFORM_IP__"
        # TAA seals every message it sends and exits at startup without this key. The remote
        # config path drops the platform block, so the Pod environment is its only source;
        # deploy.sh reads it from the host's key file when the operator did not export one.
        - name: PLATFORM_PUBLIC_KEY
          value: "__PLATFORM_PUBLIC_KEY__"
        - name: CONTRACT_ID
          value: "__CONTRACT_ID__"
        - name: TZ
          value: "Asia/Shanghai"
      securityContext:
        privileged: true
        allowPrivilegeEscalation: true
        runAsNonRoot: false
        runAsUser: 0
      # The CSV2 guest kernel registers a csv-guest misc device, but /dev inside
      # the container is a fresh tmpfs: /proc/misc lists the device while /dev
      # stays empty, and TAA then has no hardware device to attest with. The
      # minor number is not stable -- read it. Failure here is deliberately not
      # fatal: the deploy gate checks for the device and names the cause.
      lifecycle:
        postStart:
          exec:
            command:
              - /bin/sh
              - -c
              - |
                if [ -e /dev/csv-guest ]; then
                  chmod 666 /dev/csv-guest 2>/dev/null || true
                  exit 0
                fi
                retry=0
                while [ ! -r /sys/class/misc/csv-guest/dev ] && [ "$retry" -lt 60 ]; do
                  retry=$((retry + 1))
                  sleep 1
                done
                if [ -r /sys/class/misc/csv-guest/dev ]; then
                  dev=$(cat /sys/class/misc/csv-guest/dev 2>/dev/null || true)
                  major=${dev%%:*}
                  minor=${dev##*:}
                  if [ -n "$major" ] && [ -n "$minor" ]; then
                    mknod /dev/csv-guest c "$major" "$minor" 2>/dev/null || true
                    chmod 666 /dev/csv-guest 2>/dev/null || true
                  else
                    echo "csv guest device major/minor invalid: $dev" >&2
                  fi
                else
                  echo "csv guest device info missing, skip init in postStart" >&2
                fi
                exit 0
        # A DCU that was computing when its VM is killed can leave state the next VM's
        # probe cannot recover from: the card has no reset (the fixup module sets
        # NO_BUS_RESET and the function reports FLReset-), so the next guest fails in
        # `gfx_v9_0_hw_init` (`RLC ucode load fail`, probe -110) and the driver never
        # initialises. Measured on 172.16.10.178: a VM deleted 111s after its last
        # matmul handed the card over cleanly, one deleted 18s after its last matmul
        # wedged the next guest; 90s is a choice between the two, not a threshold. The
        # host cannot tell whether the card is computing (the guest's MSI goes through
        # irqbypass), so this is a fixed wait. It is the same wait deploy.sh performs
        # before it deletes a Pod itself; this hook covers teardowns that do not go
        # through that script, and the two are additive. Only a Pod that actually has
        # the card waits: without it the hook exits immediately.
        preStop:
          exec:
            command:
              - /bin/sh
              - -c
              - |
                found=0
                for dev in /sys/bus/pci/devices/*; do
                  [ "$(cat "$dev/vendor" 2>/dev/null)" = "0x1d94" ] || continue
                  case "$(cat "$dev/class" 2>/dev/null)" in
                    0x03*|0x0b40*) found=1; break ;;
                  esac
                done
                [ "$found" = 1 ] || exit 0
                echo "giving the DCU 90s of quiet before the VM is torn down"
                sleep 90
      resources:
        # Kata sizes the guest from the limits (default_memory + limits.memory,
        # default_vcpus + limits.cpu). Requests equal the limits because CSV2
        # encrypted memory is resident from boot: it is a permanent host cost,
        # not a burstable request.
        limits:
          cpu: "__CPU__"
          memory: "__MEMORY__"
        requests:
          cpu: "__CPU__"
          memory: "__MEMORY__"
