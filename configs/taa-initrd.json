{
  "server": {
    "addr": ":6001"
  },
  "storage": {
    "model": "/root/taa/models",
    "data": "/root/taa/data",
    "result": "/root/taa/results",
    "keys": "/opt/taa/keys"
  },
  "model": {
    "input": "/opt/taa/input",
    "checkpoint": "/opt/taa/checkpoint",
    "output": {
      "result": "/opt/taa/output/result",
      "log": "/opt/taa/output/log",
      "progress": "/opt/taa/output/progress/progress.json"
    }
  },
  "security": {
    "codeScan": true,
    "codeScanEngine": "semgrep",
    "semgrepRulesPath": "/opt/taa/semgrep/rules",
    "semgrepTimeoutSeconds": 900,
    "resultCheck": {
      "enabled": true,
      "maxFileBytes": 3221225472
    }
  },
  "attestation": {
    "hrkCertPath": "/etc/taa/certs/hrk.cert",
    "hskCekCertPath": "/etc/taa/certs/hsk_cek.cert"
  },
  "llm": {
    "enabled": true,
    "transport": "teetls",
    "endpoint": "https://172.16.10.116:8443",
    "model": "qwen2.5-coder:7b",
    "policy": "assist",
    "failClosed": true,
    "requestTimeoutMs": 120000,
    "insecureSkipVerify": true,
    "attestationMode": "permissive"
  }
}
