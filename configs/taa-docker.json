{
  "server": {
    "addr": ":6001"
  },
  "platform": {
    "ip": "127.0.0.1:18080",
    "dockerID": "taa-env-slim-v2",
    "contract": ""
  },
  "storage": {
    "model": "/root/taa/models",
    "data": "/root/taa/data",
    "result": "/root/taa/results",
    "keys": "/root/taa/keys"
  },
  "model": {
    "input": "/opt/taa/input",
    "output": {
      "result": "/opt/taa/output/result",
      "log": "/opt/taa/output/log",
      "progress": "/opt/taa/output/progress/progress.json"
    }
  },
  "codeAudit": {
    "codeScan": true,
    "codeScanEngine": "semgrep",
    "semgrepRulesPath": "/opt/taa/semgrep/rules",
    "resultCheck": {
      "enabled": true,
      "maxFileBytes": 3221225472
    },
    "binaryAudit": {
      "enabled": true
    },
    "llm": {
      "enabled": true,
      "transport": "teetls",
      "endpoint": "https://127.0.0.1:8443",
      "model": "qwen2.5-coder:7b",
      "policy": "assist",
      "failClosed": true,
      "requestTimeoutMs": 120000,
      "insecureSkipVerify": true,
      "attestationMode": "permissive"
    }
  },
  "attestation": {
    "hrkCertPath": "/root/taa/certs/hrk.cert",
    "hskCekCertPath": "/root/taa/certs/hsk_cek.cert"
  }
}