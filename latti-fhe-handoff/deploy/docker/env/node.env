# Common environment for every compute node. Do not put per-node values here.
API_PORT=58996
API_HOST_PORT=58996
GPU_DEVICES=0,1
GPU_UNAVAILABLE_EXIT_ENABLED=true
GPU_UNAVAILABLE_EXIT_THRESHOLD=5
GPU_UNAVAILABLE_EXIT_CODE=75

LOCAL_REDIS_PASSWORD=Latti@2024
LOCAL_REDIS_DB=14
LOCAL_REDIS_BIND_HOST=127.0.0.1
LOCAL_REDIS_HOST_PORT=58998

CONTAINER_DATA_DIR=/data
# HOST_RUNTIME_DIR defaults to <repo-root>/third_party/latti-ai-runtime when using scripts.
# Override it at startup if production uses an external runtime directory, e.g. /opt/latti-ai-runtime.
RUNTIME_DIR=/runtime/latti-ai-runtime
HOST_CUDA_DIR=/usr/local/cuda
CONTAINER_CUDA_DIR=/usr/local/cuda
LATTI_SERVER_IMAGE=latti/latti-server:latest
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
