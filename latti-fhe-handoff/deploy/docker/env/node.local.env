# Machine-local overrides for THIS handoff bundle.
#
# IMPORTANT: every path below is ABSOLUTE and points at this bundle's location.
# If you move / rename the bundle directory (or hand it to another machine),
# update BASE_DIR-style paths here accordingly.
#
#   HOST_DATA_DIR      -> mounted into the container as /data  (models/keys/tasks/results live here)
#   HOST_RUNTIME_DIR   -> mounted read-only as /runtime/latti-ai-runtime (FHE native libs + python binding)
#   HOST_REDIS_DIR     -> the node-local Redis AOF data directory
#
# If another FHE stack is already running on this host (API_PORT 58996 /
# LOCAL_REDIS_HOST_PORT 58998), change the two ports below to avoid a clash.

NODE_ID_OVERRIDE=local
NODE_IP_OVERRIDE=172.16.10.178

API_PORT=58996
API_HOST_PORT=58996
LOCAL_REDIS_BIND_HOST=127.0.0.1
LOCAL_REDIS_HOST_PORT=58998

# GPU selection: which host GPUs this node may use.
GPU_DEVICES=0
# Keep the worker alive under transient host load during testing. Production
# clusters normally leave this true so a bad GPU drains the node.
GPU_UNAVAILABLE_EXIT_ENABLED=false

# Base image used only when you re-build the server image locally.
LATTI_SERVER_BASE_IMAGE=ubuntu:24.04

# ---- paths inside this bundle (edit if the bundle is moved) ----
LATTI_DATA_ROOT=/home/jiangsy/latti-fhe-handoff/data
HOST_DATA_DIR=/home/jiangsy/latti-fhe-handoff/data
HOST_REDIS_DIR=/home/jiangsy/latti-fhe-handoff/data/redis
HOST_RUNTIME_DIR=/home/jiangsy/latti-fhe-handoff/third_party/latti-ai-runtime
LATTI_SERVER_IMAGE=latti/latti-server:latest
