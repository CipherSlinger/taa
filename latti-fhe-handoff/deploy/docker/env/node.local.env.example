# Copy this file to env/node.local.env on each compute node.
# env/node.local.env is machine-local and should not be committed.

# Required: business node identity.
# A130 example: NODE_ID_OVERRIDE=A130
# 8.62 example: NODE_ID_OVERRIDE=A62
NODE_ID_OVERRIDE=<node-id>

# Required: node IP reachable by the Nginx entry and clients inside the deployment network.
# A130 example: NODE_IP_OVERRIDE=192.168.3.130
# 8.62 example: NODE_IP_OVERRIDE=192.168.8.62
NODE_IP_OVERRIDE=<node-internal-ip>

# Common ports. Keep these aligned across A130 and 8.62.
API_PORT=58996
API_HOST_PORT=58996
LOCAL_REDIS_BIND_HOST=127.0.0.1
LOCAL_REDIS_HOST_PORT=58998

# Business routing is handled by the root nginx.conf using X-User-Id consistent hashing.

# Optional. Usually derived automatically from NODE_ID_OVERRIDE and API_PORT.
# NODE_INSTANCE=<node-id-lower>-58996
# NODE_API_URL=http://<node-internal-ip>:58996
# COMPOSE_PROJECT_NAME=fhe-node-<node-id-lower>-58996

# Optional. Defaults to <repo-root>/third_party/latti-ai-runtime when using scripts.
# For production with an external runtime directory, uncomment:
# HOST_RUNTIME_DIR=/opt/latti-ai-runtime

# Optional. Defaults to <repo-root>/var/latti.
# LATTI_DATA_ROOT=/data/latti
